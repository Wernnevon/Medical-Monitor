rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    // Dados clínicos são compartilhados por toda a clínica.
    match /patients/{id} {
      allow read, write: if logado();
    }
    match /exams/{id} {
      allow read, write: if logado();
    }
    match /prescriptions/{id} {
      allow read, write: if logado();
    }

    // Cada um só cria/edita o próprio perfil, e o papel (profissional ou
    // assistente) não muda depois do cadastro.
    match /professionals/{uid} {
      allow read: if logado();
      allow create: if logado() && request.auth.uid == uid;
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Reserva do nome de usuário: aponta para o dono e nunca é reatribuída.
    match /usernames/{username} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
